{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-bible-map/schemas/geo-provenance.schema.json",
  "title": "Geo provenance",
  "description": "Shared provenance metadata for ODbL-derived geometry layers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset",
    "version",
    "upstreamFeatureIds",
    "changes"
  ],
  "properties": {
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "upstreamFeatureIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "detail",
          "sources"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
            }
          }
        }
      }
    }
  }
}
