{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-bible-map/schemas/location.schema.json",
  "title": "Location record",
  "description": "Schema for one location file in data/locations/<id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "names",
    "type",
    "zoomTier",
    "candidates",
    "summary",
    "history",
    "scripture",
    "otConnections",
    "politicalHistory",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable location ID, lowercase kebab-case, equal to the file name.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "names": {
      "type": "object",
      "description": "Location names used in scripture matching and display.",
      "additionalProperties": false,
      "required": [
        "ancient",
        "modern",
        "alternate"
      ],
      "properties": {
        "ancient": {
          "type": "array",
          "description": "Ancient names attested in scholarship or sources.",
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "One ancient name variant.",
            "minLength": 1
          }
        },
        "modern": {
          "type": "string",
          "description": "Modern or present-day name label for orientation.",
          "minLength": 1
        },
        "alternate": {
          "type": "array",
          "description": "Additional name spellings or transliterations.",
          "items": {
            "type": "string",
            "description": "One alternate name variant.",
            "minLength": 1
          }
        }
      }
    },
    "type": {
      "type": "string",
      "description": "Location category.",
      "enum": [
        "region",
        "city",
        "town",
        "village",
        "site",
        "natural-feature"
      ]
    },
    "zoomTier": {
      "type": "string",
      "description": "Default map zoom tier for this location.",
      "enum": [
        "mediterranean",
        "region",
        "city",
        "site"
      ]
    },
    "parentId": {
      "type": "string",
      "description": "Optional parent location ID, for example a city inside a region.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "candidates": {
      "type": "array",
      "description": "Candidate coordinate locations with confidence and sources.",
      "minItems": 1,
      "items": {
        "type": "object",
        "description": "One coordinate candidate for this location.",
        "additionalProperties": false,
        "required": [
          "label",
          "coordinates",
          "coordinateSource",
          "confidence",
          "support",
          "sources"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "Short label for this candidate site.",
            "minLength": 1
          },
          "coordinates": {
            "type": "array",
            "description": "Point coordinates in WGS 84, GeoJSON order [lon, lat].",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "description": "Longitude in decimal degrees.",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "description": "Latitude in decimal degrees.",
                "minimum": -90,
                "maximum": 90
              }
            ]
          },
          "coordinateSource": {
            "description": "Single source ID from which this coordinate value was taken.",
            "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
          },
          "confidence": {
            "type": "string",
            "description": "Confidence level for this candidate.",
            "enum": [
              "high",
              "medium",
              "low",
              "disputed"
            ]
          },
          "support": {
            "type": "string",
            "description": "Neutral summary of why this candidate is proposed.",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "description": "Sources supporting this candidate.",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Neutral summary text with source IDs.",
      "additionalProperties": false,
      "required": [
        "text",
        "sources"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Short neutral location summary.",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "description": "Sources for the summary statement.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "description": "Neutral historical notes and their sources.",
      "items": {
        "type": "object",
        "description": "One historical note.",
        "additionalProperties": false,
        "required": [
          "text",
          "sources"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "Historical statement in neutral wording.",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "description": "Sources for this historical statement.",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
            }
          }
        }
      }
    },
    "scripture": {
      "type": "array",
      "description": "New Testament scripture references and WEB text.",
      "items": {
        "type": "object",
        "description": "One scripture reference and quotation.",
        "additionalProperties": false,
        "required": [
          "ref",
          "book",
          "textWEB"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Reference in normalized form, such as Mark 1:21 or Mark 1:21-22.",
            "pattern": "^(?:[1-3] )?[A-Za-z]+(?: [A-Za-z]+)* [1-9][0-9]*:[1-9][0-9]*(?:-[1-9][0-9]*)?$"
          },
          "book": {
            "type": "string",
            "description": "Book name from the 66-book Protestant canon.",
            "enum": [
              "Genesis",
              "Exodus",
              "Leviticus",
              "Numbers",
              "Deuteronomy",
              "Joshua",
              "Judges",
              "Ruth",
              "1 Samuel",
              "2 Samuel",
              "1 Kings",
              "2 Kings",
              "1 Chronicles",
              "2 Chronicles",
              "Ezra",
              "Nehemiah",
              "Esther",
              "Job",
              "Psalms",
              "Proverbs",
              "Ecclesiastes",
              "Song of Solomon",
              "Isaiah",
              "Jeremiah",
              "Lamentations",
              "Ezekiel",
              "Daniel",
              "Hosea",
              "Joel",
              "Amos",
              "Obadiah",
              "Jonah",
              "Micah",
              "Nahum",
              "Habakkuk",
              "Zephaniah",
              "Haggai",
              "Zechariah",
              "Malachi",
              "Matthew",
              "Mark",
              "Luke",
              "John",
              "Acts",
              "Romans",
              "1 Corinthians",
              "2 Corinthians",
              "Galatians",
              "Ephesians",
              "Philippians",
              "Colossians",
              "1 Thessalonians",
              "2 Thessalonians",
              "1 Timothy",
              "2 Timothy",
              "Titus",
              "Philemon",
              "Hebrews",
              "James",
              "1 Peter",
              "2 Peter",
              "1 John",
              "2 John",
              "3 John",
              "Jude",
              "Revelation"
            ]
          },
          "textWEB": {
            "type": "string",
            "description": "Exact WEB text for the reference, auto-filled by script.",
            "minLength": 1
          }
        }
      }
    },
    "otConnections": {
      "type": "array",
      "description": "Old Testament references connected to this location.",
      "items": {
        "type": "object",
        "description": "One Old Testament connection note.",
        "additionalProperties": false,
        "required": [
          "ref",
          "note",
          "sources"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Old Testament reference in normalized form, such as Isaiah 9:1.",
            "pattern": "^(?:[1-3] )?[A-Za-z]+(?: [A-Za-z]+)* [1-9][0-9]*:[1-9][0-9]*(?:-[1-9][0-9]*)?$"
          },
          "note": {
            "type": "string",
            "description": "Neutral explanation of the connection.",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "description": "Sources for this Old Testament connection.",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
            }
          }
        }
      }
    },
    "politicalHistory": {
      "type": "array",
      "description": "Date-bounded political entities connected to this location.",
      "items": {
        "type": "object",
        "description": "One political history interval with sources.",
        "additionalProperties": false,
        "required": [
          "fromYear",
          "toYear",
          "entity",
          "sources"
        ],
        "properties": {
          "fromYear": {
            "$ref": "#/$defs/yearNoZero",
            "description": "Start year as an integer, with BC negative and no year 0."
          },
          "toYear": {
            "$ref": "#/$defs/yearNoZero",
            "description": "End year as an integer, with BC negative and no year 0."
          },
          "entity": {
            "type": "string",
            "description": "Political entity label used for this interval.",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "description": "Sources for this political history interval.",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "description": "Workflow status of this record.",
      "enum": [
        "draft",
        "verified"
      ]
    },
    "verifiedBy": {
      "type": "string",
      "description": "Verifier identity; required when status is verified.",
      "minLength": 1
    },
    "lastReviewed": {
      "type": "string",
      "description": "Review date in ISO format YYYY-MM-DD; required when status is verified.",
      "format": "date"
    }
  },
  "$defs": {
    "yearNoZero": {
      "type": "integer",
      "description": "Year integer using astronomical omission of year 0 (BC years are negative).",
      "not": {
        "const": 0
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "verifiedBy",
          "lastReviewed"
        ]
      }
    }
  ]
}
