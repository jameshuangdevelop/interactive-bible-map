{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-bible-map/schemas/route-stops.schema.json",
  "title": "Route stop entries",
  "description": "CC BY-SA stop entries shared by routes when a stop has no location record yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stops"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "stops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stop"
      }
    }
  },
  "$defs": {
    "yearNoZero": {
      "type": "integer",
      "description": "Year integer with BC as negative and no year 0.",
      "not": {
        "const": 0
      }
    },
    "scriptureEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "book",
        "textWEB"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(?:[1-3] )?[A-Za-z]+(?: [A-Za-z]+)* [1-9][0-9]*:[1-9][0-9]*(?:-[1-9][0-9]*)?$"
        },
        "book": {
          "type": "string",
          "minLength": 1
        },
        "textWEB": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "coordinates",
        "coordinateSource",
        "confidence",
        "support",
        "sources"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "coordinates": {
          "type": "array",
          "description": "WGS 84 coordinates in GeoJSON [lon, lat] order.",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ]
        },
        "coordinateSource": {
          "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "disputed"
          ]
        },
        "support": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
          }
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "candidates",
        "scripture",
        "sources",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "description": "English stop name for display and search in the Routes tab.",
          "minLength": 1
        },
        "todayName": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "scripture": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scriptureEntry"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "verified"
          ]
        },
        "verifiedBy": {
          "type": "string",
          "minLength": 1
        },
        "lastReviewed": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "verifiedBy",
              "lastReviewed"
            ]
          }
        }
      ]
    }
  }
}
