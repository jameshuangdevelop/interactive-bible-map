{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-bible-map/schemas/media.schema.json",
  "title": "Location media record",
  "description": "Schema for one media file in data/media/<location-id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locationId",
    "images"
  ],
  "properties": {
    "locationId": {
      "type": "string",
      "description": "Location ID this media record belongs to.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "images": {
      "type": "array",
      "description": "Image metadata for this location (1 to 10 entries). Commons images are hotlinked; AI reconstructions are reserved for hosted media/ai/<id>.webp files.",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/mediaImage"
      }
    }
  },
  "$defs": {
    "commonsImage": {
      "type": "object",
      "description": "One Wikimedia Commons image entry.",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "width",
        "height",
        "author",
        "license",
        "licenseUrl",
        "sourcePage",
        "caption",
        "kind",
        "aiGenerated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable project image ID in <location-id>-NN format.",
          "pattern": "^(?!.*-ai-[0-9]{2}$)[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{2}$"
        },
        "url": {
          "type": "string",
          "description": "Hotlink URL for the original image asset on upload.wikimedia.org, with no query string.",
          "pattern": "^https://upload\\.wikimedia\\.org/wikipedia/commons/[0-9a-fA-F]/[0-9a-fA-F]{2}/[^?#]+$"
        },
        "width": {
          "type": "integer",
          "description": "Original Commons file width in pixels.",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "description": "Original Commons file height in pixels.",
          "minimum": 1
        },
        "author": {
          "type": "string",
          "description": "Creator attribution copied from the Commons file page.",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "description": "Image license text. Allowed: Public domain/CC0, CC BY, or CC BY-SA.",
          "pattern": "^(?:Public domain|CC0(?: 1\\.0)?|CC BY(?:-SA)? (?:(?:[1-3](?:\\.[0-9])?(?: [a-z]{2})?)|3\\.0 IGO|4\\.0))$"
        },
        "licenseUrl": {
          "type": "string",
          "description": "URL to the legal text of the recorded license.",
          "format": "uri"
        },
        "sourcePage": {
          "type": "string",
          "description": "Wikimedia Commons file page URL.",
          "pattern": "^https://commons\\.wikimedia\\.org/wiki/File:.+"
        },
        "caption": {
          "type": "string",
          "description": "Neutral caption for display in the app.",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "Image type for gallery presentation.",
          "enum": [
            "modern",
            "historical",
            "site",
            "reconstruction"
          ]
        },
        "aiGenerated": {
          "type": "boolean",
          "description": "False for Commons images.",
          "const": false
        }
      }
    },
    "aiImageGenerator": {
      "type": "object",
      "description": "Generator metadata for hosted AI reconstructions.",
      "additionalProperties": false,
      "required": [
        "tool",
        "model",
        "date"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "aiImage": {
      "type": "object",
      "description": "Reserved branch for hosted AI reconstructions (M3.5-07).",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "caption",
        "kind",
        "aiGenerated",
        "generator",
        "promptRef",
        "basedOn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable AI image ID in <location-id>-ai-NN format.",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-ai-[0-9]{2}$"
        },
        "url": {
          "type": "string",
          "description": "Repository-hosted AI image path.",
          "pattern": "^media/ai/[a-z0-9]+(?:-[a-z0-9]+)*-ai-[0-9]{2}\\.webp$"
        },
        "width": {
          "type": "integer",
          "description": "Optional recorded AI file width in pixels; if present, it must match the hosted file.",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "description": "Optional recorded AI file height in pixels; if present, it must match the hosted file.",
          "minimum": 1
        },
        "author": {
          "type": "string",
          "description": "Reserved for M3.5-07 licensing decision.",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "description": "Reserved for M3.5-07 licensing decision.",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "description": "Reserved for M3.5-07 licensing decision.",
          "format": "uri"
        },
        "sourcePage": {
          "type": "string",
          "description": "Reserved for M3.5-07 licensing decision.",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "description": "Neutral caption for display in the app.",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "AI image type for gallery presentation.",
          "const": "ai-reconstruction"
        },
        "aiGenerated": {
          "type": "boolean",
          "description": "True for hosted AI reconstructions.",
          "const": true
        },
        "generator": {
          "$ref": "#/$defs/aiImageGenerator"
        },
        "promptRef": {
          "type": "string",
          "description": "Heading reference from content/image-prompts/<location-id>.md.",
          "minLength": 1
        },
        "basedOn": {
          "type": "array",
          "description": "Source IDs cited in the related research brief and prompt.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
          }
        }
      }
    },
    "mediaImage": {
      "description": "Either a hotlinked Commons image or a reserved hosted AI reconstruction entry.",
      "oneOf": [
        {
          "$ref": "#/$defs/commonsImage"
        },
        {
          "$ref": "#/$defs/aiImage"
        }
      ]
    }
  }
}
