{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-bible-map/schemas/media.schema.json",
  "title": "Location media record",
  "description": "Schema for one media file in data/media/<location-id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locationId",
    "images"
  ],
  "properties": {
    "locationId": {
      "type": "string",
      "description": "Location ID this media record belongs to.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "images": {
      "type": "array",
      "description": "Image metadata for this location (1 to 3 entries).",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "description": "One Wikimedia Commons image entry.",
        "additionalProperties": false,
        "required": [
          "url",
          "author",
          "license",
          "licenseUrl",
          "sourcePage",
          "caption",
          "aiGenerated"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "Hotlink URL for the image asset on upload.wikimedia.org.",
            "pattern": "^https://upload\\.wikimedia\\.org/.+"
          },
          "author": {
            "type": "string",
            "description": "Creator attribution copied from the Commons file page.",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "description": "Image license text. Allowed: Public domain/CC0, CC BY, or CC BY-SA.",
            "pattern": "^(?:Public domain|CC0(?: 1\\.0)?|CC BY(?:-SA)? [0-9](?:\\.[0-9])?(?: IGO)?)$"
          },
          "licenseUrl": {
            "type": "string",
            "description": "URL to the legal text of the recorded license.",
            "format": "uri"
          },
          "sourcePage": {
            "type": "string",
            "description": "Wikimedia Commons file page URL.",
            "pattern": "^https://commons\\.wikimedia\\.org/wiki/File:.+"
          },
          "caption": {
            "type": "string",
            "description": "Neutral caption for display in the app.",
            "minLength": 1
          },
          "aiGenerated": {
            "type": "boolean",
            "description": "True only for AI-generated reconstruction images.",
            "const": false
          }
        }
      }
    }
  }
}
