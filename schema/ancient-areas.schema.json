{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-bible-map/schemas/ancient-areas.schema.json",
  "title": "Ancient area shapes",
  "description": "ODbL geometry for area polygons keyed by timeline area ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "properties",
          "geometry"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "areaId",
              "provenance"
            ],
            "properties": {
              "areaId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "provenance": {
                "$ref": "https://interactive-bible-map/schemas/geo-provenance.schema.json"
              }
            }
          },
          "geometry": {
            "oneOf": [
              {
                "$ref": "#/$defs/polygonGeometry"
              },
              {
                "$ref": "#/$defs/multiPolygonGeometry"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ]
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "polygonGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/linearRing"
          }
        }
      }
    },
    "multiPolygonGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/linearRing"
            }
          }
        }
      }
    }
  }
}
