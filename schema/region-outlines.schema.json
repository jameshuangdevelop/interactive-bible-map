{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-bible-map/schemas/region-outlines.schema.json",
  "title": "Ancient region outlines",
  "description": "ODbL geometry for selectable first-century region outlines (card M5-19).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "properties",
          "geometry"
        ],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sources",
              "confidence",
              "note"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://interactive-bible-map/schemas/source-id.schema.json#/$defs/sourceId"
                }
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "years": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "not": {
                    "const": 0
                  }
                }
              }
            }
          },
          "geometry": {
            "oneOf": [
              {
                "$ref": "#/$defs/polygonGeometry"
              },
              {
                "$ref": "#/$defs/multiPolygonGeometry"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ]
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "polygonGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/linearRing"
          }
        }
      }
    },
    "multiPolygonGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/linearRing"
            }
          }
        }
      }
    }
  }
}
