{
  "name": "interactive-bible-map-data-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app"
  ],
  "description": "Schema, validation, and scripture text tooling for Interactive Bible Map data.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "fill:scripture": "node scripts/fill-scripture-text.mjs",
    "test": "node --test",
    "validate:data": "node scripts/validate-data.mjs",
    "build:data": "node scripts/build-app-data.mjs",
    "lint": "npm run lint --workspace interactive-bible-map-app",
    "typecheck": "npm run typecheck --workspace interactive-bible-map-app",
    "test:app": "npm run test --workspace interactive-bible-map-app",
    "test:all": "npm test && npm run test:app",
    "export:web": "npm run export:web --workspace interactive-bible-map-app"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
