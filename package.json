{
  "name": "interactive-bible-map-data-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app"
  ],
  "description": "Schema, validation, and scripture text tooling for Interactive Bible Map data.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "fill:scripture": "node scripts/fill-scripture-text.mjs",
    "fill:political-history": "node scripts/fill-political-history.mjs",
    "fill:image-sizes": "node scripts/fill-image-sizes.mjs",
    "generate:ai": "node scripts/generate-ai.mjs",
    "ai-costs": "node scripts/ai-costs.mjs",
    "publish:ai": "node scripts/publish-ai.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "validate:data": "node scripts/validate-data.mjs",
    "build:data": "node scripts/build-app-data.mjs",
    "check:images": "node scripts/check-images.mjs",
    "build:openbible-ids": "node scripts/build-openbible-ids.mjs",
    "build:basemap-styles": "node scripts/build-basemap-styles.mjs",
    "bench:map": "node scripts/bench-map.mjs",
    "lint": "npm run lint --workspace interactive-bible-map-app",
    "typecheck": "npm run typecheck --workspace interactive-bible-map-app",
    "test:app": "npm run test --workspace interactive-bible-map-app",
    "test:all": "npm test && npm run test:app",
    "export:web": "node scripts/export-web.mjs",
    "verify:web:playwright": "node scripts/verify-web-export-playwright.mjs",
    "verify:web:smoke": "node scripts/verify-web-smoke-playwright.mjs",
    "verify:web:axe": "node scripts/verify-web-axe-playwright.mjs",
    "verify:web:lighthouse": "node scripts/verify-web-lighthouse.mjs",
    "check:pages:limits": "node scripts/check-pages-limits.mjs app/dist"
  },
  "dependencies": {
    "@turf/boolean-valid": "7.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "polylabel": "1.1.0",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "lighthouse": "^12.8.2",
    "playwright": "1.63.0",
    "sharp": "^0.35.5-rc.0",
    "undici": "^7.24.4"
  }
}
