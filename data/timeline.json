  "stops": [
    {
      "id": "herod-kingdom-divided",
      "year": -4,
      "title": "Herod's kingdom is divided",
      "summary": "Herod the Great dies. Augustus confirms his sons' claims but not as Herod willed them: Archelaus becomes ethnarch (not king) of Judea, Samaria and Idumea; Antipas becomes tetrarch of Galilee and Perea; Philip becomes tetrarch of Gaulanitis, Batanea, Trachonitis and Auranitis. Three Greek cities -- Gaza, Gadara and Hippos -- are cut away and added to the province of Syria.",
      "sources": [
        "bib:josephus-antiquities"
      ],
      "scripture": [
        "scripture:Matthew 2:22"
      ]
    },
    {
      "id": "judea-becomes-province",
      "year": 6,
      "title": "Judea becomes a Roman province",
      "summary": "Rome deposes Archelaus and turns his ethnarchy into a province under a prefect. Quirinius, governing Syria, conducts a census. Antipas's and Philip's territories are unaffected. Folded in here: two years earlier, the part of Pontus called \"Pontus Galaticus\" had already been added to the province of Galatia, the nearest stop to that change.",
      "sources": [
        "bib:josephus-antiquities",
        "bib:isbe-galatia"
      ],
      "scripture": [
        "scripture:Luke 2:1-2",
        "scripture:Luke 3:1"
      ]
    },
    {
      "id": "cappadocia-direct-rule",
      "year": 17,
      "title": "Cappadocia comes under direct Roman rule; Cilicia Tracheia's king also dies",
      "summary": "King Archelaus of Cappadocia dies (or is deposed) after a long reign, and his kingdom becomes a province. Strabo says Archelaus also held Cilicia Tracheia; Tacitus separately records that \"Philopator of Cilicia\" died the same year as Antiochus of Commagene, and that Rome and local opinion were divided over whether to install a new king there or govern directly. This note follows the administration-by-Syria reading for both Commagene and Cilicia Tracheia.",
      "sources": [
        "bib:tacitus-annals",
        "bib:strabo-geography"
      ]
    },
    {
      "id": "philip-tetrarchy-to-syria",
      "year": 34,
      "title": "Philip's tetrarchy is absorbed into Syria",
      "summary": "Philip dies without an heir after many years as tetrarch. Rome does not appoint a successor tetrarch; his territory is attached to the province of Syria, though its own revenues stay earmarked for it.",
      "sources": [
        "bib:josephus-antiquities"
      ]
    },
    {
      "id": "agrippa-i-made-king",
      "year": 37,
      "title": "Caligula makes Agrippa I a king",
      "summary": "The new emperor frees his friend Agrippa (Agrippa I, grandson of Herod the Great) from a Roman prison and makes him king over Philip's former tetrarchy and the neighboring tetrarchy of Abilene -- the first time since Herod the Great that any of this land is ruled by a king rather than a tetrarch, prefect or governor. Abilene itself is too small and poorly described to draw as its own area, so this change is recorded here rather than on a separate area.",
      "sources": [
        "bib:josephus-antiquities",
        "bib:isbe-abilene"
      ]
    },
    {
      "id": "antipas-banished",
      "year": 39,
      "title": "Antipas is banished; his tetrarchy joins Agrippa I's kingdom",
      "summary": "Herodias presses her husband Antipas to seek the royal title Caligula gave her brother. Caligula instead banishes Antipas and gives Galilee and Perea to Agrippa I. Folded in here: the previous year, Caligula had restored the kingdom of Commagene, with the coastal part of Cilicia Tracheia, to Antiochus IV -- a different area, placed at this later stop because it could not show on the AD 37 map above.",
      "sources": [
        "bib:josephus-antiquities",
        "bib:cassius-dio-roman-history"
      ]
    },
    {
      "id": "agrippa-i-kingdom-whole",
      "year": 41,
      "title": "Agrippa I's kingdom is made whole; new neighbors appear",
      "summary": "The new emperor Claudius adds Judea and Samaria to Agrippa I's kingdom, restoring his grandfather Herod's full extent under one ruler for the only time in this period. At the same time Claudius makes Agrippa I's brother Herod king of the new client kingdom of Chalcis (too small and poorly bordered to draw as its own area) and resolves Antiochus IV's position in Commagene and Cilicia Tracheia's coastal part.",
      "sources": [
        "bib:josephus-antiquities"
      ],
      "scripture": [
        "scripture:Acts 12:1"
      ]
    },
    {
      "id": "agrippa-i-dies",
      "year": 44,
      "title": "Agrippa I dies; direct Roman rule returns",
      "summary": "Agrippa I dies at Caesarea. Rather than let his young son inherit, Claudius places the whole kingdom -- Judea, Samaria, Galilee, Perea and Philip's former tetrarchy -- under Roman procurators. Folded in here: the previous year, Claudius had made Lycia, until then a free federation allied with Rome, a Roman province in its own right -- a different area, placed at this stop as the nearest one after AD 43.",
      "sources": [
        "bib:josephus-antiquities",
        "bib:cassius-dio-roman-history"
      ],
      "scripture": [
        "scripture:Acts 12:20-23"
      ]
    },
    {
      "id": "agrippa-ii-trades-chalcis",
      "year": 53,
      "title": "Agrippa II trades Chalcis for the northern tetrarchy",
      "summary": "Claudius, in the twelfth year of his reign, takes Chalcis back from the younger Agrippa (Agrippa I's son, ruling Chalcis since 50) and gives him Philip's former tetrarchy and Abilene instead, with the title of king. Within the next few years, Nero enlarges this grant with parts of Galilee (Tiberias and Tarichaeae) and Perea (Julias and fourteen villages), while the rest of both regions stays under the Roman procurators; Josephus dates this to Nero's first year (AD 54), but the Jewish Encyclopedia reads Agrippa II's own coinage as pointing to AD 61 for this specific addition instead. Neither of these towns is drawable land of its own, so this does not move the map's borders; it is recorded on the towns themselves, not as its own stop.",
      "sources": [
        "bib:josephus-antiquities",
        "bib:jewish-encyclopedia-agrippa-ii"
      ]
    },
    {
      "id": "jerusalem-falls",
      "year": 70,
      "title": "Jerusalem falls",
      "summary": "After four years of war, Titus's forces take Jerusalem and destroy the Second Temple, ending Jewish self-government in the province, which is now governed by a praetorian legate with a legion based at Jerusalem rather than a procurator. Agrippa II, who had sided with Rome, keeps his own separate kingdom. Folded in here: six years earlier, Polemon II had given up the independent kingdom of eastern Pontus, which the province of Galatia then absorbed as \"Pontus Polemoniacus\" -- a different area, placed at this later stop as the nearest one after AD 64.",
      "sources": [
        "bib:josephus-jewish-war",
        "bib:isbe-galatia"
      ]
    },
    {
      "id": "commagene-annexed-cilicia-reunited",
      "year": 72,
      "title": "Commagene is annexed; Cilicia is reunited",
      "summary": "Vespasian's governor of Syria accuses Antiochus IV of Commagene of plotting with Parthia and annexes his kingdom, including the coastal part of Cilicia Tracheia he held. The same year, Cilicia Pedias and Cilicia Tracheia share one province again for the first time since Augustus.",
      "sources": [
        "bib:josephus-jewish-war",
        "bib:livius-cilicia"
      ]
    },
    {
      "id": "pamphylia-joins-lycia",
      "year": 74,
      "title": "Pamphylia leaves Galatia and is joined with Lycia",
      "summary": "Vespasian joins Pamphylia with Lycia to its south, forming one new province. The existing records also describe most of Pisidia leaving Galatia for this new province at the same time, but no source describes exactly where that internal line ran, so Pisidia's own area is kept whole with Galatia on this map; only Pamphylia's and Lycia's own areas change holder here. Perga's own province changes name and neighbors, from \"Galatia\" to \"Lycia and Pamphylia,\" even though Perga's own ground does not move.",
      "sources": [
        "bib:cassius-dio-roman-history",
        "bib:isbe-pisidia"
      ]
    },
    {
      "id": "agrippa-ii-dies",
      "year": 100,
      "title": "Agrippa II dies; his kingdom joins Syria",
      "summary": "The last Herodian ruler dies. Justus of Tiberias, Agrippa II's own secretary, gave this year, read from the lost works of Justus by the ninth-century Byzantine scholar Photius; a lead weight found near Tiberias, dated to Agrippa II's own 43rd regnal year (AD 97/98), shows him still reigning shortly before. The historian Nikos Kokkinos defends this date with this and other documentary evidence. Other historians have instead read Josephus's wording in the Antiquities to place Agrippa II's death earlier, \"pre-CE 93\" -- the view of, among others, the standard reference work The History of the Jewish People in the Age of Jesus Christ as revised by Vermes and Millar (1973). This note describes both and chooses neither on its own authority. His kingdom (Gaulanitis, Batanea, Trachonitis, Auranitis and Abilene) is added to the province of Syria; Livius.org notes signs that he had already lost some territory after AD 93.",
      "sources": [
        "bib:livius-herod-agrippa-ii",
        "bib:kokkinos-justus-josephus-agrippa-coins",
        "bib:jewish-encyclopedia-agrippa-ii",
        "bib:isbe-abilene"
      ]
    }
  ],
